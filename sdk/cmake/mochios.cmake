get_filename_component(_MOCHIOS_SDK "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
set(CMAKE_SYSTEM_NAME mochiOS)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER "${_MOCHIOS_SDK}/bin/mochios-cc")
set(CMAKE_CXX_COMPILER "${_MOCHIOS_SDK}/bin/mochios-c++")
set(CMAKE_AR "${_MOCHIOS_SDK}/host/bin/ar")
set(CMAKE_RANLIB "${_MOCHIOS_SDK}/host/bin/ranlib")
set(CMAKE_SYSROOT "${_MOCHIOS_SDK}/sysroot")
list(APPEND CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_SKIP_RPATH ON CACHE BOOL "mochiOS resolves SONAME dependencies through the package loader" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
# Real executable/shared links are required; do not bypass them with static probes.
