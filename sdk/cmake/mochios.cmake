get_filename_component(_MOCHIOS_SDK "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
set(CMAKE_SYSTEM_NAME mochiOS)
file(STRINGS "${_MOCHIOS_SDK}/share/native-target" _MOCHIOS_NATIVE_TARGET LIMIT_COUNT 1)
if(_MOCHIOS_NATIVE_TARGET STREQUAL "x86_64-unknown-mochios")
  set(CMAKE_SYSTEM_PROCESSOR x86_64)
elseif(_MOCHIOS_NATIVE_TARGET STREQUAL "aarch64-unknown-mochios")
  set(CMAKE_SYSTEM_PROCESSOR aarch64)
else()
  message(FATAL_ERROR "Unsupported native SDK target: ${_MOCHIOS_NATIVE_TARGET}")
endif()
set(CMAKE_C_COMPILER "${_MOCHIOS_SDK}/bin/mochios-cc")
set(CMAKE_CXX_COMPILER "${_MOCHIOS_SDK}/bin/mochios-c++")
set(CMAKE_AR "${_MOCHIOS_SDK}/host/bin/ar")
set(CMAKE_RANLIB "${_MOCHIOS_SDK}/host/bin/ranlib")
set(CMAKE_SYSROOT "${_MOCHIOS_SDK}/sysroot")
list(APPEND CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_SKIP_RPATH ON CACHE BOOL "mochiOS resolves SONAME dependencies through the package loader" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
# Real executable/shared links are required; do not bypass them with static probes.
