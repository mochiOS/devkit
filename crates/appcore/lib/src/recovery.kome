use std::core::Drop

extern "C" from "appcore" {
	struct MochiosRecoveryStore
	struct MochiosRecoveryRecord
	struct MochiosRecoveryIdentifiers

	fn mochios_recovery_store_create_utf8(data: *const u8, length: usize) -> *mut MochiosRecoveryStore
	fn mochios_recovery_store_save_utf8(store: *mut MochiosRecoveryStore, identifierData: *const u8, identifierLength: usize, originalPathData: *const u8, originalPathLength: usize, contentTypeData: *const u8, contentTypeLength: usize, revision: u64, contentsData: *const u8, contentsLength: usize) -> i32
	fn mochios_recovery_store_load_utf8(store: *mut MochiosRecoveryStore, identifierData: *const u8, identifierLength: usize) -> *mut MochiosRecoveryRecord
	fn mochios_recovery_store_remove_utf8(store: *mut MochiosRecoveryStore, identifierData: *const u8, identifierLength: usize) -> i32
	fn mochios_recovery_store_identifiers(store: *mut MochiosRecoveryStore) -> *mut MochiosRecoveryIdentifiers
	fn mochios_recovery_identifiers_count(identifiers: *mut MochiosRecoveryIdentifiers) -> usize
	fn mochios_recovery_identifiers_get(identifiers: *mut MochiosRecoveryIdentifiers, index: usize) -> i32
	fn mochios_recovery_identifiers_destroy(identifiers: *mut MochiosRecoveryIdentifiers)
	fn mochios_recovery_record_identifier(record: *mut MochiosRecoveryRecord) -> i32
	fn mochios_recovery_record_original_path(record: *mut MochiosRecoveryRecord) -> i32
	fn mochios_recovery_record_content_type(record: *mut MochiosRecoveryRecord) -> i32
	fn mochios_recovery_record_revision(record: *mut MochiosRecoveryRecord) -> u64
	fn mochios_recovery_record_text_contents(record: *mut MochiosRecoveryRecord) -> i32
	fn mochios_recovery_record_destroy(record: *mut MochiosRecoveryRecord)
	fn mochios_recovery_store_destroy(store: *mut MochiosRecoveryStore)
}

/// ソート済みの復元用識別子を所有するコレクションを表します。
///
/// @since 27.0-dp.1
pub struct RecoveryIdentifiers {
	raw: *mut MochiosRecoveryIdentifiers,
}

for RecoveryIdentifiers {
	/// コレクションに含まれる識別子数を返します。
	///
	/// ## Returns
	///
	/// 識別子数を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let count = identifiers.count()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn count(self) -> usize {
		return mochios_recovery_identifiers_count(self.raw)
	}

	/// 指定された位置の識別子を返します。
	///
	/// ## Parameters
	///
	/// - `index`: 取得する識別子の0始まりの位置です。
	///
	/// ## Returns
	///
	/// 識別子を含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let identifier = identifiers.identifier(0)
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn identifier(self, index: usize) -> AppCoreResult<String> {
		let status = mochios_recovery_identifiers_get(self.raw, index)
		if status != 0 {
			return AppCoreResult<String> { status: status, value: null }
		}
		return AppCoreResult<String> { status: status, value: __appCoreLastString() }
	}

}

for RecoveryIdentifiers: Drop {
	/// ネイティブの識別子コレクションを解放します。
	///
	/// @since 27.0-dp.1
	fn drop(self) {
		mochios_recovery_identifiers_destroy(self.raw)
	}
}

/// 書類を復元するためのUTF-8スナップショットを表します。
///
/// @since 27.0-dp.1
pub struct RecoveryRecord {
	pub identifier: String,
	pub originalPath: String,
	pub contentType: String,
	pub revision: u64,
	pub contents: String,
}

/// アプリケーション所有のディレクトリに復元データをアトミックに保存します。
///
/// @since 27.0-dp.1
pub struct RecoveryStore {
	raw: *mut MochiosRecoveryStore,
}

for RecoveryStore {
	/// 指定したディレクトリの復元用保存領域を開きます。
	///
	/// ## Parameters
	///
	/// - `directory`: 復元データを保存するディレクトリです。
	///
	/// ## Returns
	///
	/// 作成された`RecoveryStore`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let store = RecoveryStore.make("/Application/Recovery")
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn make(directory: String) -> RecoveryStore {
		return RecoveryStore { raw: mochios_recovery_store_create_utf8(__kome_string_data(directory), __kome_string_len(directory)) }
	}

	/// UTF-8の復元レコードをアトミックに保存します。
	///
	/// ## Parameters
	///
	/// - `record`: 保存する復元レコードです。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// store.save(record)
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn save(self, record: RecoveryRecord) -> i32 {
		return mochios_recovery_store_save_utf8(self.raw, __kome_string_data(record.identifier), __kome_string_len(record.identifier), __kome_string_data(record.originalPath), __kome_string_len(record.originalPath), __kome_string_data(record.contentType), __kome_string_len(record.contentType), record.revision, __kome_string_data(record.contents), __kome_string_len(record.contents))
	}

	/// UTF-8の復元レコードを読み込みます。
	///
	/// ## Parameters
	///
	/// - `identifier`: 読み込むレコードの識別子です。
	///
	/// ## Returns
	///
	/// 復元レコードを含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let record = store.load("document-1")
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn load(self, identifier: String) -> AppCoreResult<RecoveryRecord> {
		let raw = mochios_recovery_store_load_utf8(self.raw, __kome_string_data(identifier), __kome_string_len(identifier))
		let status = AppCore.lastStatus()
		if status != 0 || mochios_last_result_has_value() == 0 {
			return AppCoreResult<RecoveryRecord> { status: status, value: null }
		}
		mochios_recovery_record_identifier(raw)
		let recordIdentifier = __appCoreLastString()
		mochios_recovery_record_original_path(raw)
		var originalPath = ""
		if mochios_last_result_has_value() != 0 {
			originalPath = __appCoreLastString()
		}
		mochios_recovery_record_content_type(raw)
		let contentType = __appCoreLastString()
		let revision = mochios_recovery_record_revision(raw)
		let contentsStatus = mochios_recovery_record_text_contents(raw)
		if contentsStatus != 0 {
			mochios_recovery_record_destroy(raw)
			return AppCoreResult<RecoveryRecord> { status: contentsStatus, value: null }
		}
		let contents = __appCoreLastString()
		mochios_recovery_record_destroy(raw)
		return AppCoreResult<RecoveryRecord> { status: status, value: RecoveryRecord { identifier: recordIdentifier, originalPath: originalPath, contentType: contentType, revision: revision, contents: contents } }
	}

	/// 復元レコードを削除します。
	///
	/// ## Parameters
	///
	/// - `identifier`: 削除するレコードの識別子です。
	///
	/// ## Returns
	///
	/// レコードを削除した場合は`true`を含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let removed = store.remove("document-1")
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn remove(self, identifier: String) -> AppCoreResult<bool> {
		let status = mochios_recovery_store_remove_utf8(self.raw, __kome_string_data(identifier), __kome_string_len(identifier))
		if status != 0 {
			return AppCoreResult<bool> { status: status, value: null }
		}
		return AppCoreResult<bool> { status: status, value: mochios_last_result_u64() != 0 }
	}

	/// ソート済みのすべての復元用識別子を読み込みます。
	///
	/// ## Returns
	///
	/// 識別子コレクションを含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let identifiers = store.identifiers()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn identifiers(self) -> AppCoreResult<RecoveryIdentifiers> {
		let raw = mochios_recovery_store_identifiers(self.raw)
		let status = AppCore.lastStatus()
		if status != 0 {
			return AppCoreResult<RecoveryIdentifiers> { status: status, value: null }
		}
		return AppCoreResult<RecoveryIdentifiers> { status: status, value: RecoveryIdentifiers { raw: raw } }
	}

}

for RecoveryStore: Drop {
	/// ネイティブの復元用保存領域を解放します。
	///
	/// @since 27.0-dp.1
	fn drop(self) {
		mochios_recovery_store_destroy(self.raw)
	}
}
