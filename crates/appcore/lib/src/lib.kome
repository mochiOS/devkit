extern "C" from "appcore" {
	// Returns the AppCore C ABI version.
	fn mochios_abi_version() -> u32

	// Returns the native system error saved by the latest failed call.
	fn mochios_last_system_error() -> i64
}

// Provides process-wide AppCore information.
struct AppCore {}

for AppCore {
	// Returns the loaded AppCore C ABI version.
	fn abiVersion() -> u32 {
		return mochios_abi_version()
	}

	// Returns the native system error saved by the latest failed call.
	fn lastSystemError() -> i64 {
		return mochios_last_system_error()
	}
}
