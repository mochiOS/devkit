use std::core::Drop

extern "C" from "appcore" {
	struct MochiosOpenPanel
	struct MochiosSavePanel

	// Creates an open panel.
	fn mochios_open_panel_create_utf8(titleData: *const u8, titleLength: usize, initialData: *const u8, initialLength: usize, rootData: *const u8, rootLength: usize) -> *mut MochiosOpenPanel
	fn mochios_open_panel_show(panel: *mut MochiosOpenPanel) -> i32
	fn mochios_open_panel_allow_content_type_utf8(panel: *mut MochiosOpenPanel, data: *const u8, length: usize) -> i32
	fn mochios_open_panel_show_at_utf8(panel: *mut MochiosOpenPanel, data: *const u8, length: usize) -> i32
	fn mochios_open_panel_is_visible(panel: *mut MochiosOpenPanel) -> u8
	fn mochios_open_panel_take_selection(panel: *mut MochiosOpenPanel) -> i32
	fn mochios_open_panel_take_cancelled(panel: *mut MochiosOpenPanel) -> u8
	fn mochios_open_panel_destroy(panel: *mut MochiosOpenPanel)

	// Creates a save panel.
	fn mochios_save_panel_create_utf8(titleData: *const u8, titleLength: usize, suggestedData: *const u8, suggestedLength: usize, initialData: *const u8, initialLength: usize, rootData: *const u8, rootLength: usize, confirmsReplacement: bool) -> *mut MochiosSavePanel
	fn mochios_save_panel_show(panel: *mut MochiosSavePanel) -> i32
	fn mochios_save_panel_allow_content_type_utf8(panel: *mut MochiosSavePanel, data: *const u8, length: usize) -> i32
	fn mochios_save_panel_show_for_utf8(panel: *mut MochiosSavePanel, directoryData: *const u8, directoryLength: usize, nameData: *const u8, nameLength: usize) -> i32
	fn mochios_save_panel_is_visible(panel: *mut MochiosSavePanel) -> u8
	fn mochios_save_panel_take_selection(panel: *mut MochiosSavePanel) -> i32
	fn mochios_save_panel_take_cancelled(panel: *mut MochiosSavePanel) -> u8
	fn mochios_save_panel_destroy(panel: *mut MochiosSavePanel)
}

/// 書類を開くパネルの設定を表します。
///
/// @since 27.0-dp.1
pub struct OpenPanelOptions {
	title: String,
	initialDirectory: String,
	rootDirectory: String,
}

for OpenPanelOptions {
	/// 標準的な設定を返します。
	///
	/// ## Returns
	///
	/// 標準的な`OpenPanelOptions`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let options = OpenPanelOptions.defaults()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn defaults() -> OpenPanelOptions {
		return OpenPanelOptions { title: "Open", initialDirectory: "", rootDirectory: "" }
	}
}

/// ワークスペースが管理する書類選択パネルを表します。
///
/// @since 27.0-dp.1
pub struct OpenPanel {
	raw: *mut MochiosOpenPanel,
}

for OpenPanel {
	/// 書類選択パネルを作成します。
	///
	/// ## Parameters
	///
	/// - `options`: パネルの設定です。
	///
	/// ## Returns
	///
	/// 作成された`OpenPanel`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let panel = OpenPanel.make(OpenPanelOptions.defaults())
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn make(options: OpenPanelOptions) -> OpenPanel {
		return OpenPanel { raw: mochios_open_panel_create_utf8(__kome_string_data(options.title), __kome_string_len(options.title), __kome_string_data(options.initialDirectory), __kome_string_len(options.initialDirectory), __kome_string_data(options.rootDirectory), __kome_string_len(options.rootDirectory)) }
	}

	/// パネルに表示するコンテンツタイプを追加します。
	///
	/// ## Parameters
	///
	/// - `contentType`: 表示を許可するコンテンツタイプです。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// panel.allowContentType(ContentType.PLAIN_TEXT)
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn allowContentType(self, contentType: ContentType) -> i32 {
		return mochios_open_panel_allow_content_type_utf8(self.raw, __kome_string_data(contentType.identifier), __kome_string_len(contentType.identifier))
	}

	/// パネルを表示します。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// panel.show()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn show(self) -> i32 {
		return mochios_open_panel_show(self.raw)
	}

	/// 指定したディレクトリでパネルを表示します。
	///
	/// ## Parameters
	///
	/// - `directory`: 最初に表示するディレクトリです。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// panel.showAt("/Documents")
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn showAt(self, directory: String) -> i32 {
		return mochios_open_panel_show_at_utf8(self.raw, __kome_string_data(directory), __kome_string_len(directory))
	}

	/// パネルが表示されているかどうかを返します。
	///
	/// ## Returns
	///
	/// 表示中の場合は`true`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let visible = panel.isVisible()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn isVisible(self) -> bool {
		return mochios_open_panel_is_visible(self.raw) != 0
	}

	/// 直近に選択されたパスを取得します。
	///
	/// 取得した選択結果はパネルから取り除かれます。
	///
	/// ## Returns
	///
	/// 選択されたパスを含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let selection = panel.takeSelection()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn takeSelection(self) -> AppCoreResult<String> {
		let status = mochios_open_panel_take_selection(self.raw)
		if status != 0 || mochios_last_result_has_value() == 0 {
			return AppCoreResult<String> { status: status, value: null }
		}
		return AppCoreResult<String> { status: status, value: __appCoreLastString() }
	}

	/// ユーザーがキャンセルしたかどうかを取得します。
	///
	/// 取得後にキャンセル状態は消去されます。
	///
	/// ## Returns
	///
	/// ユーザーがキャンセルした場合は`true`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let cancelled = panel.takeCancelled()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn takeCancelled(self) -> bool {
		return mochios_open_panel_take_cancelled(self.raw) != 0
	}

}

for OpenPanel: Drop {
	/// ネイティブのパネルを解放します。
	///
	/// @since 27.0-dp.1
	fn drop(self) {
		mochios_open_panel_destroy(self.raw)
	}
}

/// 書類を保存するパネルの設定を表します。
///
/// @since 27.0-dp.1
pub struct SavePanelOptions {
	title: String,
	suggestedName: String,
	initialDirectory: String,
	rootDirectory: String,
	confirmsReplacement: bool,
}

for SavePanelOptions {
	/// 標準的な設定を返します。
	///
	/// ## Returns
	///
	/// 標準的な`SavePanelOptions`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let options = SavePanelOptions.defaults()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn defaults() -> SavePanelOptions {
		return SavePanelOptions { title: "Save As", suggestedName: "Untitled", initialDirectory: "", rootDirectory: "", confirmsReplacement: true }
	}
}

/// ワークスペースが管理する書類保存パネルを表します。
///
/// @since 27.0-dp.1
pub struct SavePanel {
	raw: *mut MochiosSavePanel,
}

for SavePanel {
	/// 書類保存パネルを作成します。
	///
	/// ## Parameters
	///
	/// - `options`: パネルの設定です。
	///
	/// ## Returns
	///
	/// 作成された`SavePanel`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let panel = SavePanel.make(SavePanelOptions.defaults())
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn make(options: SavePanelOptions) -> SavePanel {
		return SavePanel { raw: mochios_save_panel_create_utf8(__kome_string_data(options.title), __kome_string_len(options.title), __kome_string_data(options.suggestedName), __kome_string_len(options.suggestedName), __kome_string_data(options.initialDirectory), __kome_string_len(options.initialDirectory), __kome_string_data(options.rootDirectory), __kome_string_len(options.rootDirectory), options.confirmsReplacement) }
	}

	/// パネルが受け付けるコンテンツタイプを追加します。
	///
	/// ## Parameters
	///
	/// - `contentType`: 受け付けるコンテンツタイプです。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// panel.allowContentType(ContentType.PLAIN_TEXT)
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn allowContentType(self, contentType: ContentType) -> i32 {
		return mochios_save_panel_allow_content_type_utf8(self.raw, __kome_string_data(contentType.identifier), __kome_string_len(contentType.identifier))
	}

	/// パネルを表示します。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// panel.show()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn show(self) -> i32 {
		return mochios_save_panel_show(self.raw)
	}

	/// ディレクトリと推奨ファイル名を指定してパネルを表示します。
	///
	/// ## Parameters
	///
	/// - `directory`: 最初に表示するディレクトリです。
	/// - `suggestedName`: 推奨するファイル名です。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// panel.showFor("/Documents", "Untitled.txt")
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn showFor(self, directory: String, suggestedName: String) -> i32 {
		return mochios_save_panel_show_for_utf8(self.raw, __kome_string_data(directory), __kome_string_len(directory), __kome_string_data(suggestedName), __kome_string_len(suggestedName))
	}

	/// パネルが表示されているかどうかを返します。
	///
	/// ## Returns
	///
	/// 表示中の場合は`true`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let visible = panel.isVisible()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn isVisible(self) -> bool {
		return mochios_save_panel_is_visible(self.raw) != 0
	}

	/// 直近に選択されたパスを取得します。
	///
	/// 取得した選択結果はパネルから取り除かれます。
	///
	/// ## Returns
	///
	/// 選択されたパスを含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let selection = panel.takeSelection()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn takeSelection(self) -> AppCoreResult<String> {
		let status = mochios_save_panel_take_selection(self.raw)
		if status != 0 || mochios_last_result_has_value() == 0 {
			return AppCoreResult<String> { status: status, value: null }
		}
		return AppCoreResult<String> { status: status, value: __appCoreLastString() }
	}

	/// ユーザーがキャンセルしたかどうかを取得します。
	///
	/// 取得後にキャンセル状態は消去されます。
	///
	/// ## Returns
	///
	/// ユーザーがキャンセルした場合は`true`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let cancelled = panel.takeCancelled()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn takeCancelled(self) -> bool {
		return mochios_save_panel_take_cancelled(self.raw) != 0
	}

}

for SavePanel: Drop {
	/// ネイティブのパネルを解放します。
	///
	/// @since 27.0-dp.1
	fn drop(self) {
		mochios_save_panel_destroy(self.raw)
	}
}
