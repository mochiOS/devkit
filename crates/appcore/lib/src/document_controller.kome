use std::core::Drop

extern "C" from "appcore" {
	struct MochiosDocumentController
	fn mochios_document_controller_create_utf8(displayNameData: *const u8, displayNameLength: usize, pathData: *const u8, pathLength: usize, fileTypeData: *const u8, fileTypeLength: usize, encodingData: *const u8, encodingLength: usize, writable: u8, revision: u64) -> *mut MochiosDocumentController
	fn mochios_document_controller_set_revision(controller: *mut MochiosDocumentController, revision: u64) -> i32
	fn mochios_document_controller_is_edited(controller: *mut MochiosDocumentController) -> u8
	fn mochios_document_controller_open(controller: *mut MochiosDocumentController) -> i32
	fn mochios_document_controller_save(controller: *mut MochiosDocumentController) -> i32
	fn mochios_document_controller_save_as(controller: *mut MochiosDocumentController) -> i32
	fn mochios_document_controller_revert(controller: *mut MochiosDocumentController) -> i32
	fn mochios_document_controller_request_close(controller: *mut MochiosDocumentController) -> i32
	fn mochios_document_controller_take_action(controller: *mut MochiosDocumentController) -> i32
	fn mochios_document_controller_complete_utf8(controller: *mut MochiosDocumentController, displayNameData: *const u8, displayNameLength: usize, pathData: *const u8, pathLength: usize, fileTypeData: *const u8, fileTypeLength: usize, encodingData: *const u8, encodingLength: usize, writable: u8, revision: u64) -> i32
	fn mochios_document_controller_fail_utf8(controller: *mut MochiosDocumentController, messageData: *const u8, messageLength: usize) -> i32
	fn mochios_document_controller_display_name(controller: *mut MochiosDocumentController) -> i32
	fn mochios_document_controller_path(controller: *mut MochiosDocumentController) -> i32
	fn mochios_document_controller_file_type(controller: *mut MochiosDocumentController) -> i32
	fn mochios_document_controller_encoding(controller: *mut MochiosDocumentController) -> i32
	fn mochios_document_controller_status(controller: *mut MochiosDocumentController) -> i32
	fn mochios_document_controller_clear_status(controller: *mut MochiosDocumentController) -> i32
	fn mochios_document_controller_destroy(controller: *mut MochiosDocumentController)
}

/// 保存される書類の形式を表します。
///
/// @since 27.0-dp.1
pub struct DocumentMetadata {
	fileType: String,
	encoding: String,
	writable: bool,
}

for DocumentMetadata {
	/// 書き込み可能な書類情報を作成します。
	///
	/// ## Parameters
	///
	/// - `fileType`: 書類のファイル形式です。
	/// - `encoding`: 書類の文字エンコーディングです。
	///
	/// ## Returns
	///
	/// 作成された`DocumentMetadata`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let metadata = DocumentMetadata.make("text/plain", "utf-8")
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn make(fileType: String, encoding: String) -> DocumentMetadata {
		return DocumentMetadata { fileType: fileType, encoding: encoding, writable: true }
	}

	/// 書き込み可否を変更した複製を返します。
	///
	/// ## Parameters
	///
	/// - `writable`: 書き込み可能にする場合は`true`です。
	///
	/// ## Returns
	///
	/// 書き込み可否が変更された`DocumentMetadata`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let metadata = metadata.withWritable(false)
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn withWritable(self, writable: bool) -> DocumentMetadata {
		return DocumentMetadata { fileType: self.fileType, encoding: self.encoding, writable: writable }
	}
}

/// 書類の表示名と保存情報を表します。
///
/// @since 27.0-dp.1
pub struct DocumentInfo {
	displayName: String,
	path: String,
	metadata: DocumentMetadata,
}

for DocumentInfo {
	/// 未命名の書類情報を作成します。
	///
	/// ## Parameters
	///
	/// - `metadata`: 書類の保存形式です。
	///
	/// ## Returns
	///
	/// 作成された`DocumentInfo`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let info = DocumentInfo.untitled(metadata)
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn untitled(metadata: DocumentMetadata) -> DocumentInfo {
		return DocumentInfo { displayName: "Untitled", path: "", metadata: metadata }
	}

	/// 名前とパスを持つ書類情報を作成します。
	///
	/// ## Parameters
	///
	/// - `displayName`: ユーザーに表示する書類名です。
	/// - `path`: 書類の保存パスです。
	/// - `metadata`: 書類の保存形式です。
	///
	/// ## Returns
	///
	/// 作成された`DocumentInfo`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let info = DocumentInfo.at("Note.txt", "/Documents/Note.txt", metadata)
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn at(displayName: String, path: String, metadata: DocumentMetadata) -> DocumentInfo {
		return DocumentInfo { displayName: displayName, path: path, metadata: metadata }
	}
}

/// アプリケーションが実行すべき書類操作を表します。
///
/// @since 27.0-dp.1
pub struct DocumentControllerAction {
	value: u64,
}

for DocumentControllerAction {
	/// 書類を開く操作です。
	///
	/// @since 27.0-dp.1
	pub const OPEN: DocumentControllerAction = DocumentControllerAction { value: 1 }
	/// 書類を保存する操作です。
	///
	/// @since 27.0-dp.1
	pub const SAVE: DocumentControllerAction = DocumentControllerAction { value: 2 }
	/// 書類を別名で保存する操作です。
	///
	/// @since 27.0-dp.1
	pub const SAVE_AS: DocumentControllerAction = DocumentControllerAction { value: 3 }
	/// 書類を保存済みの状態へ戻す操作です。
	///
	/// @since 27.0-dp.1
	pub const REVERT: DocumentControllerAction = DocumentControllerAction { value: 4 }
	/// 書類を閉じる操作です。
	///
	/// @since 27.0-dp.1
	pub const CLOSE: DocumentControllerAction = DocumentControllerAction { value: 5 }
}

/// 1つのファイルに保存される書類の生存期間を管理します。
///
/// @since 27.0-dp.1
pub struct DocumentController {
	raw: *mut MochiosDocumentController,
}

for DocumentController {
	/// 初期の書類情報から管理器を作成します。
	///
	/// ## Parameters
	///
	/// - `info`: 初期の書類情報です。
	/// - `revision`: アプリケーションが管理する初期版番です。
	///
	/// ## Returns
	///
	/// 作成された`DocumentController`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let controller = DocumentController.make(info, 0)
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn make(info: DocumentInfo, revision: u64) -> DocumentController {
		var writable: u8 = 0
		if info.metadata.writable { writable = 1 }
		return DocumentController { raw: mochios_document_controller_create_utf8(__kome_string_data(info.displayName), __kome_string_len(info.displayName), __kome_string_data(info.path), __kome_string_len(info.path), __kome_string_data(info.metadata.fileType), __kome_string_len(info.metadata.fileType), __kome_string_data(info.metadata.encoding), __kome_string_len(info.metadata.encoding), writable, revision) }
	}

	/// アプリケーションが管理する書類の版番を更新します。
	///
	/// ## Parameters
	///
	/// - `revision`: 新しい版番です。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// @since 27.0-dp.1
	pub fn setRevision(self, revision: u64) -> i32 { return mochios_document_controller_set_revision(self.raw, revision) }
	/// 書類が保存済みの版番から変更されたかどうかを返します。
	///
	/// ## Returns
	///
	/// 変更されている場合は`true`を返します。
	///
	/// @since 27.0-dp.1
	pub fn isEdited(self) -> bool { return mochios_document_controller_is_edited(self.raw) != 0 }
	/// 書類を開く操作を要求します。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// @since 27.0-dp.1
	pub fn open(self) -> i32 { return mochios_document_controller_open(self.raw) }
	/// 状態に応じて保存または別名保存を要求します。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// @since 27.0-dp.1
	pub fn save(self) -> i32 { return mochios_document_controller_save(self.raw) }
	/// 別名保存を要求します。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// @since 27.0-dp.1
	pub fn saveAs(self) -> i32 { return mochios_document_controller_save_as(self.raw) }
	/// 保存済みの状態へ戻す操作を要求します。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// @since 27.0-dp.1
	pub fn revert(self) -> i32 { return mochios_document_controller_revert(self.raw) }

	/// 書類を閉じるよう要求します。
	///
	/// ## Returns
	///
	/// すぐに閉じられる場合は`true`を含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let closable = controller.requestClose()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn requestClose(self) -> AppCoreResult<bool> {
		let status = mochios_document_controller_request_close(self.raw)
		if status != 0 { return AppCoreResult<bool> { status: status, value: null } }
		return AppCoreResult<bool> { status: status, value: mochios_last_result_u64() != 0 }
	}

	/// アプリケーションが実行すべき次の書類操作を取得します。
	///
	/// ## Returns
	///
	/// 書類操作を含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let action = controller.takeAction()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn takeAction(self) -> AppCoreResult<DocumentControllerAction> {
		let status = mochios_document_controller_take_action(self.raw)
		if status != 0 || mochios_last_result_has_value() == 0 { return AppCoreResult<DocumentControllerAction> { status: status, value: null } }
		return AppCoreResult<DocumentControllerAction> { status: status, value: DocumentControllerAction { value: mochios_last_result_u64() } }
	}

	/// 新しい保存済み書類情報を使って操作を完了します。
	///
	/// ## Parameters
	///
	/// - `info`: 操作完了後の書類情報です。
	/// - `revision`: 操作完了後の版番です。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// controller.complete(info, revision)
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn complete(self, info: DocumentInfo, revision: u64) -> i32 {
		var writable: u8 = 0
		if info.metadata.writable { writable = 1 }
		return mochios_document_controller_complete_utf8(self.raw, __kome_string_data(info.displayName), __kome_string_len(info.displayName), __kome_string_data(info.path), __kome_string_len(info.path), __kome_string_data(info.metadata.fileType), __kome_string_len(info.metadata.fileType), __kome_string_data(info.metadata.encoding), __kome_string_len(info.metadata.encoding), writable, revision)
	}

	/// エラーを記録して操作を終了します。
	///
	/// ## Parameters
	///
	/// - `message`: 記録するエラーメッセージです。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// controller.fail("書類を保存できませんでした。")
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn fail(self, message: String) -> i32 { return mochios_document_controller_fail_utf8(self.raw, __kome_string_data(message), __kome_string_len(message)) }

	/// 現在の書類の表示名を返します。
	///
	/// ## Returns
	///
	/// 表示名を含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let name = controller.displayName()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn displayName(self) -> AppCoreResult<String> { let status = mochios_document_controller_display_name(self.raw) if status != 0 { return AppCoreResult<String> { status: status, value: null } } return AppCoreResult<String> { status: status, value: __appCoreLastString() } }
	/// 現在の書類のパスを返します。
	///
	/// ## Returns
	///
	/// パスがある場合はその文字列を含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let path = controller.path()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn path(self) -> AppCoreResult<String> { let status = mochios_document_controller_path(self.raw) if status != 0 || mochios_last_result_has_value() == 0 { return AppCoreResult<String> { status: status, value: null } } return AppCoreResult<String> { status: status, value: __appCoreLastString() } }
	/// 直近の書類操作エラーを返します。
	///
	/// ## Returns
	///
	/// エラーメッセージがある場合はその文字列を含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let status = controller.status()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn status(self) -> AppCoreResult<String> { let status = mochios_document_controller_status(self.raw) if status != 0 || mochios_last_result_has_value() == 0 { return AppCoreResult<String> { status: status, value: null } } return AppCoreResult<String> { status: status, value: __appCoreLastString() } }
	/// 直近の書類操作エラーを消去します。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// controller.clearStatus()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn clearStatus(self) -> i32 { return mochios_document_controller_clear_status(self.raw) }
}

for DocumentController: Drop {
	/// ネイティブの書類管理器を解放します。
	///
	/// @since 27.0-dp.1
	fn drop(self) { mochios_document_controller_destroy(self.raw) }
}
