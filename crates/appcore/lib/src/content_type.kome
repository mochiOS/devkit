extern "C" from "appcore" {
	// Validates and canonicalizes a content type.
	fn mochios_content_type_parse_utf8(data: *const u8, length: usize) -> i32

	// Resolves a path to a canonical content type.
	fn mochios_content_type_for_path_utf8(data: *const u8, length: usize) -> i32

	// Resolves an extension to a canonical content type.
	fn mochios_content_type_for_extension_utf8(data: *const u8, length: usize) -> i32

	// Tests content-type conformance.
	fn mochios_content_type_conforms_utf8(valueData: *const u8, valueLength: usize, parentData: *const u8, parentLength: usize) -> u8

	// Resolves the preferred extension for a content type.
	fn mochios_content_type_preferred_extension_utf8(data: *const u8, length: usize) -> i32
}

/// 検証済みの標準化されたMIME形式のコンテンツ識別子を表します。
///
/// @since 27.0-dp.1
pub struct ContentType {
	identifier: String,
}

for ContentType {
	/// 任意のバイナリデータを表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const DATA: ContentType = ContentType { identifier: "application/octet-stream" }
	/// プレーンテキストを表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const PLAIN_TEXT: ContentType = ContentType { identifier: "text/plain" }
	/// UTF-8のプレーンテキストを表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const UTF8_PLAIN_TEXT: ContentType = ContentType { identifier: "text/plain;charset=utf-8" }
	/// JSON書類を表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const JSON: ContentType = ContentType { identifier: "application/json" }
	/// XML書類を表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const XML: ContentType = ContentType { identifier: "application/xml" }
	/// HTML書類を表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const HTML: ContentType = ContentType { identifier: "text/html" }
	/// CSSスタイルシートを表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const CSS: ContentType = ContentType { identifier: "text/css" }
	/// JavaScriptソースコードを表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const JAVASCRIPT: ContentType = ContentType { identifier: "text/javascript" }
	/// Markdown書類を表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const MARKDOWN: ContentType = ContentType { identifier: "text/markdown" }
	/// PNG画像を表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const PNG: ContentType = ContentType { identifier: "image/png" }
	/// JPEG画像を表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const JPEG: ContentType = ContentType { identifier: "image/jpeg" }
	/// SVG画像を表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const SVG: ContentType = ContentType { identifier: "image/svg+xml" }
	/// PDF書類を表すコンテンツタイプです。
	///
	/// @since 27.0-dp.1
	pub const PDF: ContentType = ContentType { identifier: "application/pdf" }

	/// コンテンツタイプの識別子を検証して標準化します。
	///
	/// ## Parameters
	///
	/// - `identifier`: 検証するMIME形式の識別子です。
	///
	/// ## Returns
	///
	/// 成功時は標準化された`ContentType`を含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let result = ContentType.parse("text/plain;charset=utf-8")
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn parse(identifier: String) -> AppCoreResult<ContentType> {
		let status = mochios_content_type_parse_utf8(__kome_string_data(identifier), __kome_string_len(identifier))
		if status != 0 {
			return AppCoreResult<ContentType> { status: status, value: null }
		}
		return AppCoreResult<ContentType> { status: status, value: ContentType { identifier: __appCoreLastString() } }
	}

	/// ファイル名またはパスからコンテンツタイプを解決します。
	///
	/// ## Parameters
	///
	/// - `path`: コンテンツタイプを解決するファイル名またはパスです。
	///
	/// ## Returns
	///
	/// 解決された`ContentType`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let type = ContentType.forPath("Document.md")
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn forPath(path: String) -> ContentType {
		mochios_content_type_for_path_utf8(__kome_string_data(path), __kome_string_len(path))
		return ContentType { identifier: __appCoreLastString() }
	}

	/// ファイル拡張子からコンテンツタイプを解決します。
	///
	/// ## Parameters
	///
	/// - `extension`: 先頭のピリオドを除いたファイル拡張子です。
	///
	/// ## Returns
	///
	/// 解決された`ContentType`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let type = ContentType.fromExtension("json")
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn fromExtension(extension: String) -> ContentType {
		mochios_content_type_for_extension_utf8(__kome_string_data(extension), __kome_string_len(extension))
		return ContentType { identifier: __appCoreLastString() }
	}

	/// このコンテンツタイプが指定された上位タイプに適合するかを返します。
	///
	/// ## Parameters
	///
	/// - `parent`: 適合関係を確認する上位のコンテンツタイプです。
	///
	/// ## Returns
	///
	/// 適合する場合は`true`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let conforms = ContentType.UTF8_PLAIN_TEXT.conformsTo(ContentType.PLAIN_TEXT)
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn conformsTo(self, parent: ContentType) -> bool {
		return mochios_content_type_conforms_utf8(__kome_string_data(self.identifier), __kome_string_len(self.identifier), __kome_string_data(parent.identifier), __kome_string_len(parent.identifier)) != 0
	}

	/// 推奨されるファイル拡張子を返します。
	///
	/// ## Returns
	///
	/// 拡張子が既知の場合は文字列を含む`AppCoreResult`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let extension = ContentType.JSON.preferredExtension()
	/// ```
	///
	/// @since 27.0-dp.1
	pub fn preferredExtension(self) -> AppCoreResult<String> {
		let status = mochios_content_type_preferred_extension_utf8(__kome_string_data(self.identifier), __kome_string_len(self.identifier))
		if status != 0 || mochios_last_result_has_value() == 0 {
			return AppCoreResult<String> { status: status, value: null }
		}
		return AppCoreResult<String> { status: status, value: __appCoreLastString() }
	}
}
