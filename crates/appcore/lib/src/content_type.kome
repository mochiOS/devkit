extern "C" from "appcore" {
	// Validates and canonicalizes a content type.
	fn mochios_content_type_parse_utf8(data: *const u8, length: usize) -> i32

	// Resolves a path to a canonical content type.
	fn mochios_content_type_for_path_utf8(data: *const u8, length: usize) -> i32

	// Resolves an extension to a canonical content type.
	fn mochios_content_type_for_extension_utf8(data: *const u8, length: usize) -> i32

	// Tests content-type conformance.
	fn mochios_content_type_conforms_utf8(valueData: *const u8, valueLength: usize, parentData: *const u8, parentLength: usize) -> u8

	// Resolves the preferred extension for a content type.
	fn mochios_content_type_preferred_extension_utf8(data: *const u8, length: usize) -> i32
}

// A validated, canonical MIME-style content identifier.
struct ContentType {
	identifier: String,
}

for ContentType {
	const DATA: ContentType = ContentType { identifier: "application/octet-stream" }
	const PLAIN_TEXT: ContentType = ContentType { identifier: "text/plain" }
	const UTF8_PLAIN_TEXT: ContentType = ContentType { identifier: "text/plain;charset=utf-8" }
	const JSON: ContentType = ContentType { identifier: "application/json" }
	const XML: ContentType = ContentType { identifier: "application/xml" }
	const HTML: ContentType = ContentType { identifier: "text/html" }
	const CSS: ContentType = ContentType { identifier: "text/css" }
	const JAVASCRIPT: ContentType = ContentType { identifier: "text/javascript" }
	const MARKDOWN: ContentType = ContentType { identifier: "text/markdown" }
	const PNG: ContentType = ContentType { identifier: "image/png" }
	const JPEG: ContentType = ContentType { identifier: "image/jpeg" }
	const SVG: ContentType = ContentType { identifier: "image/svg+xml" }
	const PDF: ContentType = ContentType { identifier: "application/pdf" }

	// Parses and canonicalizes a content type identifier.
	fn parse(identifier: String) -> AppCoreResult<ContentType> {
		let status = mochios_content_type_parse_utf8(__kome_string_data(identifier), __kome_string_len(identifier))
		if status != 0 {
			return AppCoreResult<ContentType> { status: status, value: null }
		}
		return AppCoreResult<ContentType> { status: status, value: ContentType { identifier: __appCoreLastString() } }
	}

	// Resolves a filename or path to its content type.
	fn forPath(path: String) -> ContentType {
		mochios_content_type_for_path_utf8(__kome_string_data(path), __kome_string_len(path))
		return ContentType { identifier: __appCoreLastString() }
	}

	// Resolves a filename extension to its content type.
	fn fromExtension(extension: String) -> ContentType {
		mochios_content_type_for_extension_utf8(__kome_string_data(extension), __kome_string_len(extension))
		return ContentType { identifier: __appCoreLastString() }
	}

	// Tests whether this content type conforms to a broader type.
	fn conformsTo(self, parent: ContentType) -> bool {
		return mochios_content_type_conforms_utf8(__kome_string_data(self.identifier), __kome_string_len(self.identifier), __kome_string_data(parent.identifier), __kome_string_len(parent.identifier)) != 0
	}

	// Returns the preferred filename extension when one is known.
	fn preferredExtension(self) -> AppCoreResult<String> {
		let status = mochios_content_type_preferred_extension_utf8(__kome_string_data(self.identifier), __kome_string_len(self.identifier))
		if status != 0 || mochios_last_result_has_value() == 0 {
			return AppCoreResult<String> { status: status, value: null }
		}
		return AppCoreResult<String> { status: status, value: __appCoreLastString() }
	}
}
