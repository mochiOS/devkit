extern "C" from "appcore" {
	struct MochiosUndoManager
	fn mochios_undo_manager_create() -> *mut MochiosUndoManager
	fn mochios_undo_manager_begin_group_utf8(manager: *mut MochiosUndoManager, nameData: *const u8, nameLength: usize) -> i32
	fn mochios_undo_manager_end_group(manager: *mut MochiosUndoManager) -> i32
	fn mochios_undo_manager_set_action_name_utf8(manager: *mut MochiosUndoManager, nameData: *const u8, nameLength: usize) -> i32
	fn mochios_undo_manager_register_utf8(manager: *mut MochiosUndoManager, nameData: *const u8, nameLength: usize, undoAction: u64, redoAction: u64) -> i32
	fn mochios_undo_manager_can_undo(manager: *mut MochiosUndoManager) -> u8
	fn mochios_undo_manager_can_redo(manager: *mut MochiosUndoManager) -> u8
	fn mochios_undo_manager_undo_action_name(manager: *mut MochiosUndoManager) -> i32
	fn mochios_undo_manager_redo_action_name(manager: *mut MochiosUndoManager) -> i32
	fn mochios_undo_manager_undo(manager: *mut MochiosUndoManager) -> i32
	fn mochios_undo_manager_redo(manager: *mut MochiosUndoManager) -> i32
	fn mochios_undo_manager_remove_all(manager: *mut MochiosUndoManager) -> i32
	fn mochios_undo_manager_set_levels(manager: *mut MochiosUndoManager, levels: usize) -> i32
	fn mochios_undo_manager_grouping_level(manager: *mut MochiosUndoManager) -> usize
	fn mochios_undo_manager_take_action(manager: *mut MochiosUndoManager) -> i32
	fn mochios_undo_manager_destroy(manager: *mut MochiosUndoManager)
}

// A reversible operation represented by application-owned action IDs.
struct UndoOperation {
	name: String,
	undoAction: u64,
	redoAction: u64,
}

// Records reversible operations and emits their action IDs during replay.
struct UndoManager {
	raw: *mut MochiosUndoManager,
}

for UndoManager {
	// Creates an empty undo manager.
	fn make() -> UndoManager {
		return UndoManager { raw: mochios_undo_manager_create() }
	}

	// Starts an atomic undo group.
	fn beginGroup(self, name: String) -> i32 {
		return mochios_undo_manager_begin_group_utf8(self.raw, __kome_string_data(name), __kome_string_len(name))
	}

	// Finishes the current group and reports whether one was open.
	fn endGroup(self) -> AppCoreResult<bool> {
		let status = mochios_undo_manager_end_group(self.raw)
		if status != 0 {
			return AppCoreResult<bool> { status: status, value: null }
		}
		return AppCoreResult<bool> { status: status, value: mochios_last_result_u64() != 0 }
	}

	// Changes the title of the currently open group.
	fn setActionName(self, name: String) -> i32 {
		return mochios_undo_manager_set_action_name_utf8(self.raw, __kome_string_data(name), __kome_string_len(name))
	}

	// Registers one reversible operation.
	fn register(self, operation: UndoOperation) -> i32 {
		return mochios_undo_manager_register_utf8(self.raw, __kome_string_data(operation.name), __kome_string_len(operation.name), operation.undoAction, operation.redoAction)
	}

	// Returns whether an undo operation is available.
	fn canUndo(self) -> bool {
		return mochios_undo_manager_can_undo(self.raw) != 0
	}

	// Returns whether a redo operation is available.
	fn canRedo(self) -> bool {
		return mochios_undo_manager_can_redo(self.raw) != 0
	}

	// Returns the current undo action name.
	fn undoActionName(self) -> AppCoreResult<String> {
		let status = mochios_undo_manager_undo_action_name(self.raw)
		if status != 0 || mochios_last_result_has_value() == 0 {
			return AppCoreResult<String> { status: status, value: null }
		}
		return AppCoreResult<String> { status: status, value: __appCoreLastString() }
	}

	// Returns the current redo action name.
	fn redoActionName(self) -> AppCoreResult<String> {
		let status = mochios_undo_manager_redo_action_name(self.raw)
		if status != 0 || mochios_last_result_has_value() == 0 {
			return AppCoreResult<String> { status: status, value: null }
		}
		return AppCoreResult<String> { status: status, value: __appCoreLastString() }
	}

	// Performs the latest undo operation.
	fn undo(self) -> AppCoreResult<bool> {
		let status = mochios_undo_manager_undo(self.raw)
		if status != 0 {
			return AppCoreResult<bool> { status: status, value: null }
		}
		return AppCoreResult<bool> { status: status, value: mochios_last_result_u64() != 0 }
	}

	// Performs the latest redo operation.
	fn redo(self) -> AppCoreResult<bool> {
		let status = mochios_undo_manager_redo(self.raw)
		if status != 0 {
			return AppCoreResult<bool> { status: status, value: null }
		}
		return AppCoreResult<bool> { status: status, value: mochios_last_result_u64() != 0 }
	}

	// Takes the next action ID emitted by undo or redo.
	fn takeAction(self) -> AppCoreResult<u64> {
		let status = mochios_undo_manager_take_action(self.raw)
		if status != 0 || mochios_last_result_has_value() == 0 {
			return AppCoreResult<u64> { status: status, value: null }
		}
		return AppCoreResult<u64> { status: status, value: mochios_last_result_u64() }
	}

	// Removes all undo and redo history.
	fn removeAllActions(self) -> i32 {
		return mochios_undo_manager_remove_all(self.raw)
	}

	// Sets the maximum number of committed undo groups.
	fn setLevelsOfUndo(self, levels: usize) -> i32 {
		return mochios_undo_manager_set_levels(self.raw, levels)
	}

	// Returns the current nested grouping level.
	fn groupingLevel(self) -> usize {
		return mochios_undo_manager_grouping_level(self.raw)
	}

	// Releases the native undo manager.
	fn close(self) {
		mochios_undo_manager_destroy(self.raw)
	}
}
