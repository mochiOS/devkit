use std::core

extern "C" from "appcore" {
	struct MochiosControlCenterItem

	// Creates a Control Center item builder.
	fn mochios_control_center_item_create_utf8(bundleIdData: *const u8, bundleIdLength: usize, itemIdData: *const u8, itemIdLength: usize) -> *mut MochiosControlCenterItem

	// Sets the title of a Control Center item.
	fn mochios_control_center_item_set_title_utf8(item: *mut MochiosControlCenterItem, data: *const u8, length: usize) -> i32

	// Appends one row to a Control Center item.
	fn mochios_control_center_item_add_row_utf8(item: *mut MochiosControlCenterItem, labelData: *const u8, labelLength: usize, valueData: *const u8, valueLength: usize) -> i32

	// Publishes a Control Center item.
	fn mochios_control_center_item_publish(item: *mut MochiosControlCenterItem) -> i32

	// Destroys a Control Center item builder.
	fn mochios_control_center_item_destroy(item: *mut MochiosControlCenterItem)
}

/// AppCoreが所有する宣言的なControl Centerカードを表します。
///
/// @since 27.0-dp.1
struct ControlCenterItem {
	raw: *mut MochiosControlCenterItem,
}

for ControlCenterItem {
	/// Manifestで宣言されたControl Center項目の登録を開始します。
	///
	/// ## Parameters
	///
	/// - `bundleId`: 項目を所有するアプリケーションのBundle IDです。
	/// - `itemId`: Manifestで宣言された項目の識別子です。
	///
	/// ## Returns
	///
	/// 登録内容を構築する`ControlCenterItem`を返します。
	///
	/// ## Example
	///
	/// ```kome
	/// let item = ControlCenterItem.register("org.example.app", "status")
	/// ```
	///
	/// @since 27.0-dp.1
	fn register(bundleId: String, itemId: String) -> ControlCenterItem {
		return ControlCenterItem { raw: mochios_control_center_item_create_utf8(__kome_string_data(bundleId), __kome_string_len(bundleId), __kome_string_data(itemId), __kome_string_len(itemId)) }
	}

	/// カードのタイトルを置き換えます。
	///
	/// ## Parameters
	///
	/// - `title`: カードに表示するタイトルです。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// item.title("システム状態")
	/// ```
	///
	/// @since 27.0-dp.1
	fn title(self, title: String) -> i32 {
		return mochios_control_center_item_set_title_utf8(self.raw, __kome_string_data(title), __kome_string_len(title))
	}

	/// カードへラベルと値の行を追加します。
	///
	/// ## Parameters
	///
	/// - `label`: 行のラベルです。
	/// - `value`: 行に表示する値です。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// item.row("状態", "正常")
	/// ```
	///
	/// @since 27.0-dp.1
	fn row(self, label: String, value: String) -> i32 {
		return mochios_control_center_item_add_row_utf8(self.raw, __kome_string_data(label), __kome_string_len(label), __kome_string_data(value), __kome_string_len(value))
	}

	/// カードを公開し、既存のカードがある場合は置き換えます。
	///
	/// ## Returns
	///
	/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
	///
	/// ## Example
	///
	/// ```kome
	/// item.publish()
	/// ```
	///
	/// @since 27.0-dp.1
	fn publish(self) -> i32 {
		return mochios_control_center_item_publish(self.raw)
	}

}

for ControlCenterItem: Drop {
	/// ネイティブのカード構築オブジェクトを解放します。
	///
	/// @since 27.0-dp.1
	fn drop(self) {
		mochios_control_center_item_destroy(self.raw)
	}
}
